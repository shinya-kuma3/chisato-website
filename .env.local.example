# ============================================================
# このファイルを .env.local にコピーして値を埋めてください
# .env.local は Git にコミットされません
# ============================================================

# ---------- データ保存 (Supabase) ----------
# 未設定なら .data/ のローカルJSONに保存されます (開発用)
# Supabase ダッシュボード > Project Settings > API から取得
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role キー (絶対に公開しない)


# ---------- 管理コンソール ----------
# 管理画面のURL: /console/<ADMIN_PATH_KEY>
# 推測されないランダムな文字列にしてください (16文字以上)
# 生成例: node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
ADMIN_PATH_KEY=0gInij9VTkCzifaeldvueg

# セッションCookieの署名鍵 (32文字以上のランダム文字列)
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=Kb6M9K-x1URyK1JSBAeH6Rrb_eHOoz5DHspaKAR37LA

# 管理者として許可するGoogleアカウント (カンマ区切りで複数可)
ADMIN_EMAILS=shinya.creative@gmail.com

# Google Cloud Console > APIとサービス > 認証情報 で作成した
# 「OAuth 2.0 クライアント ID」(種類: ウェブアプリケーション)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# 本番で自動判定がうまくいかない場合のみ設定 (Google側の設定と完全一致させる)
# GOOGLE_REDIRECT_URI=https://example.com/api/auth/google/callback
